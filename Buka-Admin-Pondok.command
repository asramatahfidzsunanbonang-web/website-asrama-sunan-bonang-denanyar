#!/bin/bash
# ========================================================
# Launcher SiTahfidz - Panel Lengkap Administrator Pondok
# Klik ganda file ini untuk membuka 10 Menu Admin di browser
# ========================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
echo "Membuka Panel Administrator Pondok (admin-tahfidz.html) di browser..."
open "$DIR/admin-tahfidz.html"
