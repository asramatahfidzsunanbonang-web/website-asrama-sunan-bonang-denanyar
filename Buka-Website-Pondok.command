#!/bin/bash
# ========================================================
# Launcher Website Resmi Pondok Pesantren
# Klik ganda file ini untuk membuka website langsung di browser
# ========================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
echo "Membuka Website Resmi Pondok Pesantren di browser..."
open "$DIR/index.html"
